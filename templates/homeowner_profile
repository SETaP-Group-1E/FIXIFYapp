{% extends "layout.html" %}
{% block content %}
<!-- Added: homeowner profile has details and saved contractor reviews. -->
<section class="mt-5">
    <div class="dashboard-header mb-4">
        <div>
            <span class="eyebrow">Homeowner profile</span>
            <h1 class="text-white font-weight-bold mt-2">{{ profile.display_name }}</h1>
            <p class="text-light mb-0">{{ profile.bio or 'No profile summary added yet.' }}</p>
        </div>
        <div class="d-flex flex-wrap" style="gap: 0.5rem;">
            <a href="{{ url_for('setup_profile', role='homeowner') }}" class="btn btn-outline-light">Edit Profile</a>
            <a href="{{ url_for('homeowner_dashboard') }}" class="btn btn-fixify">My Jobs</a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <span>Location</span>
                <strong style="font-size: 1.25rem;">{{ profile.location or 'Not added' }}</strong>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <span>Contact</span>
                <strong style="font-size: 1.25rem;">{{ profile.phone or 'Not added' }}</strong>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <span>Contractor reviews</span>
                <strong>{{ reviews|length }}</strong>
            </div>
        </div>
    </div>

    <div class="fixify-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
            <div>
                <span class="eyebrow">Reviews</span>
                <h3 class="text-white font-weight-bold mb-0">Saved homeowner reviews</h3>
            </div>
            {% if average_rating %}
            <span class="badge badge-primary p-2">Average {{ average_rating }}/5</span>
            {% endif %}
        </div>

        {% if reviews %}
            {% for review in reviews %}
            <div class="alert alert-light">
                <div class="d-flex justify-content-between flex-wrap">
                    <strong>Contractor review for job #{{ review.job_id }}</strong>
                    <span>{{ review_score(review) }}/5</span>
                </div>
                {% if review.comment %}
                <p class="mb-1 mt-2">{{ review.comment }}</p>
                {% endif %}
                {% if review.photo_filename %}
                <a href="{{ url_for('uploaded_file', filename=review.photo_filename) }}" target="_blank">View review photo</a>
                {% endif %}
            </div>
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <h4>No saved reviews yet</h4>
                <p>Contractor reviews will appear here after completed jobs.</p>
            </div>
        {% endif %}
    </div>
</section>
{% endblock content %}
